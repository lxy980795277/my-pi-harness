{
  "name": "@my-pi-harness/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/bootstrap.ts",
    "start": "node --env-file-if-exists=../../.env dist/bootstrap.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:built": "vitest run --config vitest.built.config.ts"
  },
  "dependencies": {
    "@fastify/static": "catalog:",
    "@my-pi-harness/protocol": "workspace:*",
    "@my-pi-harness/execution": "workspace:*",
    "fastify": "catalog:",
    "pino": "catalog:",
    "typebox": "catalog:",
    "@my-pi-harness/storage": "workspace:*",
    "@my-pi-harness/agent-runtime": "workspace:*",
    "@my-pi-harness/integrations": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite": "catalog:"
  }
}
