{
  "name": "@my-pi-harness/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/http/server.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/bootstrap.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/bootstrap.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:deployment": "vitest run --config vitest.deployment.config.ts"
  },
  "dependencies": {
    "@fastify/static": "catalog:",
    "@my-pi-harness/protocol": "workspace:*",
    "fastify": "catalog:",
    "pino": "catalog:",
    "typebox": "catalog:",
    "@my-pi-harness/storage": "workspace:*",
    "@my-pi-harness/agent-runtime": "workspace:*",
    "@my-pi-harness/integrations": "workspace:*",
    "@my-pi-harness/sandbox": "workspace:*",
    "@my-pi-harness/tools": "workspace:*",
    "tsx": "catalog:",
    "@my-pi-harness/plugins": "workspace:*",
    "@huggingface/transformers": "catalog:",
    "@my-pi-harness/memory": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite": "catalog:"
  }
}
