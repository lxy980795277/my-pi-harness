# Development commands load the repository-root .env in the daemon only.
MY_PI_HARNESS_GITHUB_CLIENT_ID=your_github_oauth_app_client_id

# Web authorization-code login also requires a Client Secret.
# Electron Device Flow needs only the Client ID and Device Flow enabled on GitHub.
# MY_PI_HARNESS_GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
# MY_PI_HARNESS_GITHUB_CALLBACK_URL=http://127.0.0.1:5174/api/auth/callback/github

# Optional: absolute path of an explicitly prepared Python environment for Office tools.
# MY_PI_HARNESS_OFFICE_PYTHON=/absolute/path/to/office-venv/bin/python
