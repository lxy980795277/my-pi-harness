# Development commands load the repository-root .env in the daemon only.
MY_PI_HARNESS_GITHUB_CLIENT_ID=your_github_oauth_app_client_id

# Web authorization-code login also requires a Client Secret.
# Electron Device Flow needs only the Client ID and Device Flow enabled on GitHub.
# MY_PI_HARNESS_GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
# MY_PI_HARNESS_GITHUB_CALLBACK_URL=http://127.0.0.1:5174/api/auth/callback/github

# Plugin authorization uses dedicated daemon clients; no application-login fallback.
# Set both fields, and register the exact plugin callback with the provider.
# MY_PI_HARNESS_SKILL_GITHUB_CLIENT_ID=your_plugin_github_client_id
# MY_PI_HARNESS_SKILL_GITHUB_CLIENT_SECRET=your_plugin_github_client_secret
# MY_PI_HARNESS_SKILL_GITHUB_CALLBACK_URL=http://127.0.0.1:5174/api/skill-connections/github/oauth/callback
# MY_PI_HARNESS_SKILL_GOOGLE_CLIENT_ID=your_google_client_id
# MY_PI_HARNESS_SKILL_GOOGLE_CLIENT_SECRET=your_google_client_secret
# MY_PI_HARNESS_SKILL_GOOGLE_CALLBACK_URL=http://127.0.0.1:5174/api/skill-connections/google/oauth/callback
# NOTION, SUPABASE and VERCEL use the same SKILL_<SERVICE> naming convention.
# Without CALLBACK_URL the daemon uses its listening origin and the plugin callback path.

# Optional: absolute path of an explicitly prepared Python environment for Office tools.
# MY_PI_HARNESS_OFFICE_PYTHON=/absolute/path/to/office-venv/bin/python
